<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Hocotate_Toolkit</AssemblyName>
    <RootNamespace>RARCToolkit</RootNamespace>
    <!-- 単一バイナリにする場合: dotnet publish -r linux-x64 -c Release -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- ── バイナリのプロパティ情報 ── -->
    <Product>Hocotate Toolkit (Linux)</Product>
    <Description>Hocotate Toolkit for Linux</Description>
    <Company>C2H4</Company>
    <Copyright>C2H4</Copyright>
    <AssemblyVersion>1.27.0.0</AssemblyVersion>
    <FileVersion>1.27.0.0</FileVersion>
    <Version>1.27.0</Version>
    <InformationalVersion>1.27a-linux</InformationalVersion>
    <NeutralLanguage>en</NeutralLanguage>

    <!-- ── ビルド環境の情報（パス・ユーザー名）をバイナリに埋め込まない ── -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <!-- ソースファイルの絶対パスを ./ に置換してユーザー名を除去 -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=./</PathMap>
    <!-- ソースコードや追跡情報のバイナリへの埋め込みを無効化 -->
    <EmbedAllSources>false</EmbedAllSources>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <!-- SourceLink（Gitリポジトリ情報の埋め込み）を無効化 -->
    <EnableSourceLink>false</EnableSourceLink>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="7.0.0" />
  </ItemGroup>
</Project>

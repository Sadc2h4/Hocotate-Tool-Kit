<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>FBX_analysis</AssemblyName>
    <RootNamespace>fbx_analysis</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- FBX_analysis 用に切り出したモデル読込処理は net10.0 / LangVersion preview を使用 -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- ビルド環境の個人情報をバイナリに埋め込まない -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=./</PathMap>
    <EmbedAllSources>false</EmbedAllSources>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <EnableSourceLink>false</EnableSourceLink>
    <!-- 製品情報 -->
    <Product>FBX_analysis</Product>
    <Authors>C2H4</Authors>
    <Company></Company>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <Copyright>C2H4</Copyright>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Version>2.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 同名ネイティブ DLL 競合を無視 -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="vendor\**\*.cs" />
    <EmbeddedResource Remove="vendor\**\*" />
    <None Remove="vendor\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="vendor\FbxModelCore\GameCube\JSystem\FbxModelCore.JSystem.csproj" />
  </ItemGroup>
</Project>
